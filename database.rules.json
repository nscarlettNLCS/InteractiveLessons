{
  "rules": {
    "rooms": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && ((!data.exists() && newData.child('owner').val() === auth.uid) || data.child('owner').val() === auth.uid)",
        "joined": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && root.child('rooms').child($code).child('owner').exists()",
            ".validate": "newData.isBoolean() || (newData.hasChildren(['name']) && newData.child('name').isString() && newData.child('name').val().length >= 1 && newData.child('name').val().length <= 40)"
          }
        },
        "votes": {
          "$q": {
            "$uid": {
              ".write": "auth != null && auth.uid === $uid && root.child('rooms').child($code).child('open').val() === true && root.child('rooms').child($code).child('active').val() === $q",
              ".validate": "(newData.isNumber() && newData.val() >= 0 && newData.val() < 6) || (newData.isString() && newData.val().length > 0 && newData.val().length <= 120) || (newData.hasChildren(['code', 'pass', 'of']) && newData.child('code').isString() && newData.child('code').val().length <= 4000)",
              "code": {
                ".validate": "newData.isString() && newData.val().length <= 4000"
              },
              "pass": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 50"
              },
              "of": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 50"
              },
              "r": {
                ".validate": "newData.isString() && newData.val().length <= 50"
              },
              "$other": {
                ".validate": false
              }
            }
          }
        },
        "done": {
          "$a": {
            "$uid": {
              ".write": "auth != null && auth.uid === $uid && root.child('rooms').child($code).child('owner').exists()",
              ".validate": "newData.isBoolean()"
            }
          }
        }
      }
    }
  }
}